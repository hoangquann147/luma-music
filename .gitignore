# Distribute binaries separately from source
*.exe
*.dll
*.apk
*.aab
*.zip
*.7z
*.tar
*.gz

# Personal audio never belongs in the source repository
*.flac
*.m4a
*.mp3
*.wav
*.aac
*.ogg
*.opus
*.aiff
*.dsf
*.dff

# Keep the tool manifest and licenses, fetch executables locally
desktop/resources/tools/*
!desktop/resources/tools/manifest.json
!desktop/resources/tools/THIRD-PARTY-NOTICES.md
!desktop/resources/tools/licenses/
