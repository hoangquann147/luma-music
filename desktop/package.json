{
  "name": "luma",
  "version": "1.0.0",
  "description": "Luma Rust native music player for Windows",
  "private": true,
  "type": "module",
  "author": "Luma contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config vite.web.config.ts --host 127.0.0.1",
    "build": "tsc --noEmit --project tsconfig.rust.json && vite build --config vite.web.config.ts",
    "typecheck": "tsc --noEmit --project tsconfig.rust.json",
    "rust:build": "cargo build --manifest-path src-tauri/Cargo.toml --release",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:package": "npm run build && npm run rust:build && node scripts/package-rust.mjs .build-tools/installer-payload",
    "tools:fetch": "node scripts/fetch-tools.mjs",
    "tools:prepare": "node scripts/prepare-rust-tools.mjs",
    "dist:win": "npm run rust:package && node scripts/build-installer.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
